{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floatcut.local/protocol/v1/envelope.schema.json",
  "type": "object",
  "required": ["v", "type", "message_id"],
  "properties": {
    "v": { "const": 1 },
    "type": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
