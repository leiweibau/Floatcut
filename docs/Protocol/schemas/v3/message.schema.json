    },
    {
      "$ref": "control.schema.json"
    },
    {
      "$ref": "clipboard-text.schema.json"
    },
    {
      "$ref": "clipboard-image.schema.json"
    },
    {
      "$ref": "file-transfer.schema.json"
    }
  ]
}
