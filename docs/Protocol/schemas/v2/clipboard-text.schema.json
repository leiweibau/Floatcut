{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": ["clip_id", "source_device_id", "created_at_ms", "content_type", "utf8_size", "content_sha256", "hop_count", "content"],
  "properties": {
    "type": { "const": "CLIPBOARD_UPDATE" },
    "clip_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source_device_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "created_at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "content_type": { "const": "text/plain;charset=utf-8" },
    "utf8_size": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hop_count": { "const": 0 },
    "content": { "type": "string" }
  }
}
